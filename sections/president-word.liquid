{%- style -%}
  .president-word {
    max-width: 720px;
    margin: 0 auto;
    border: 1px solid var(--bt-line);
    padding: 56px 32px;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .president-word {
      padding: 72px 60px;
    }
  }

  .president-word__quote {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: clamp(2.2rem, 4vw, 2.8rem);
    line-height: 1.3;
    max-width: 620px;
    margin: 0 auto 32px;
  }

  .president-word__signature {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 32px;
  }

  .president-word__avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--bt-line);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .president-word__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .president-word__avatar-fallback {
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
  }

  .president-word__signature-text {
    text-align: left;
  }

  .president-word__name {
    display: block;
    font-weight: 500;
    font-size: 1.5rem;
  }

  .president-word__title {
    display: block;
    color: var(--bt-grey);
    font-size: 1.3rem;
  }
{%- endstyle -%}

<div class="page-width section-{{ section.id }}-padding">
  <div class="president-word color-{{ section.settings.color_scheme }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'quote' -%}
          <p class="president-word__quote" {{ block.shopify_attributes }}>{{ block.settings.quote }}</p>
        {%- when 'signature' -%}
          <div class="president-word__signature" {{ block.shopify_attributes }}>
            <div class="president-word__avatar">
              {%- if block.settings.avatar != blank -%}
                <img src="{{ block.settings.avatar | image_url: width: 96 }}" alt="{{ block.settings.name | escape }}" width="48" height="48" loading="lazy">
              {%- else -%}
                <span class="president-word__avatar-fallback">{{ block.settings.name | slice: 0, 1 }}</span>
              {%- endif -%}
            </div>
            <div class="president-word__signature-text">
              <span class="president-word__name">{{ block.settings.name }}</span>
              <span class="president-word__title">{{ block.settings.title }}</span>
            </div>
          </div>
        {%- when 'button' -%}
          <a href="{{ block.settings.button_link }}" class="link underlined-link" {{ block.shopify_attributes }}>
            {{ block.settings.button_label }}
          </a>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Mot du président",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "quote",
      "name": "Citation",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "Citation",
          "default": "<p>Votre citation ici.</p>"
        }
      ]
    },
    {
      "type": "signature",
      "name": "Signature",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Photo (optionnel)"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nom",
          "default": "Nom du président"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Fonction",
          "default": "Fondateur & président"
        }
      ]
    },
    {
      "type": "button",
      "name": "Bouton",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Texte du bouton",
          "default": "Lire le mot du président"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Lien du bouton"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Mot du président",
      "blocks": [
        { "type": "quote" },
        { "type": "signature" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
